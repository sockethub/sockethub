{
  "name": "@sockethub/platform-caldav",
  "description": "A Sockethub platform for synchronizing CalDAV calendars, events, and tasks",
  "version": "1.0.0-beta.7",
  "type": "module",
  "private": false,
  "license": "LGPL-3.0+",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sockethub/sockethub.git",
    "directory": "packages/platform-caldav"
  },
  "homepage": "https://github.com/sockethub/sockethub/tree/master/packages/platform-caldav",
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node --format esm --sourcemap=external",
    "clean": "rm -rf dist",
    "clean:deps": "rm -rf node_modules",
    "test": "bun test src/"
  },
  "dependencies": {
    "@sockethub/dav": "^1.0.0-beta.7",
    "@sockethub/schemas": "^3.0.0-beta.7",
    "@sockethub/util": "^1.0.0-beta.7",
    "undici": "^7.30.0"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "@sockethub/server": "^5.0.0-beta.7"
  },
  "peerDependenciesMeta": {
    "@sockethub/server": {
      "optional": true
    }
  },
  "types": "./dist/index.d.ts",
  "gitHead": "483bff5c43a92b8e17e7dbed00f91adba66e8b6c"
}
