{
  "name": "@sockethub/platform-caldav",
  "description": "A Sockethub platform for synchronizing CalDAV calendars, events, and tasks",
  "version": "1.0.0-alpha.4",
  "type": "module",
  "private": false,
  "license": "LGPL-3.0+",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sockethub/sockethub.git",
    "directory": "packages/platform-caldav"
  },
  "homepage": "https://github.com/sockethub/sockethub/tree/master/packages/platform-caldav",
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node --format esm --sourcemap=external",
    "clean": "rm -rf dist",
    "clean:deps": "rm -rf node_modules",
    "test": "bun test src/"
  },
  "dependencies": {
    "@sockethub/dav": "^1.0.0-alpha.1",
    "@sockethub/schemas": "^3.0.0-alpha.20",
    "@sockethub/util": "^1.0.0-alpha.8"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "undici": "^7.19.0"
  },
  "peerDependencies": {
    "@sockethub/server": "^5.0.0-alpha.20"
  },
  "peerDependenciesMeta": {
    "@sockethub/server": {
      "optional": true
    }
  },
  "types": "./dist/index.d.ts",
  "gitHead": "194422de2ffe1a95ffff45063bc988da8594756a"
}
