{
  "name": "sockethub",
  "description": "A polyglot messaging service",
  "version": "5.0.0-beta.3",
  "private": false,
  "author": "Nick Jennings <nick@silverbucket.net>",
  "license": "LGPL-3.0+",
  "main": "",
  "bin": "bin/sockethub",
  "preferGlobal": true,
  "engines": {
    "node": ">=20.19"
  },
  "keywords": [
    "sockethub",
    "messaging",
    "polyglot",
    "unhosted",
    "apis",
    "api",
    "protocols",
    "protocol",
    "irc",
    "xmpp",
    "facebook",
    "rss",
    "atom",
    "twitter",
    "smtp",
    "imap",
    "email"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sockethub/sockethub.git",
    "directory": "packages/sockethub"
  },
  "homepage": "https://sockethub.org",
  "dependencies": {
    "@sockethub/platform-caldav": "^1.0.0-beta.3",
    "@sockethub/platform-carddav": "^1.0.0-beta.3",
    "@sockethub/platform-dummy": "^3.0.0-beta.3",
    "@sockethub/platform-email": "^1.0.0-beta.3",
    "@sockethub/platform-feeds": "^4.0.0-beta.3",
    "@sockethub/platform-instagram": "^1.0.0-beta.3",
    "@sockethub/platform-irc": "^4.0.0-beta.3",
    "@sockethub/platform-messenger": "^1.0.0-beta.3",
    "@sockethub/platform-metadata": "^1.0.1-beta.3",
    "@sockethub/platform-whatsapp": "^1.0.0-beta.3",
    "@sockethub/platform-xmpp": "^5.0.0-beta.3",
    "@sockethub/server": "^5.0.0-beta.3"
  },
  "scripts": {
    "build": "bun build.js",
    "clean:deps": "rm -rf node_modules",
    "dev": "SOCKETHUB_HTTP_ACTIONS_ENABLED=true bun run --hot ./bin/sockethub --examples",
    "info": "node ./bin/sockethub --info",
    "start": "node ./bin/sockethub",
    "start:logged": "bun ./bin/sockethub-logged"
  },
  "gitHead": "bc04522d60d1e2fa1b3098b339897de62c3b0549"
