{
  "name": "@sockethub/dav",
  "description": "Shared WebDAV transport, authentication, and XML utilities for Sockethub platforms",
  "version": "1.0.0-beta.3",
  "type": "module",
  "private": false,
  "license": "LGPL-3.0+",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node --format esm --sourcemap=external",
    "clean": "rm -rf dist",
    "clean:deps": "rm -rf node_modules",
    "test": "bun test src/"
  },
  "dependencies": {
    "@sockethub/util": "^1.0.0-beta.3",
    "fast-xml-parser": "^5.10.1",
    "undici": "^7.30.0"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "gitHead": "bc04522d60d1e2fa1b3098b339897de62c3b0549"
}
