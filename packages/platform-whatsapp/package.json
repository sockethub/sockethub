{
  "name": "@sockethub/platform-whatsapp",
  "description": "Outgoing text messages through the WhatsApp Business Cloud API",
  "version": "1.0.0-beta.7",
  "type": "module",
  "private": false,
  "license": "LGPL-3.0+",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node --format esm --sourcemap=external",
    "clean": "rm -rf dist",
    "clean:deps": "rm -rf node_modules",
    "test": "bun test src/"
  },
  "dependencies": {
    "@sockethub/schemas": "^3.0.0-beta.7"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "@sockethub/server": "^5.0.0-beta.7"
  },
  "peerDependenciesMeta": {
    "@sockethub/server": {
      "optional": true
    }
  },
  "gitHead": "483bff5c43a92b8e17e7dbed00f91adba66e8b6c"
}
